# Postgres — used by the docker-compose db service and by the app to connect.
# POSTGRES_HOST/POSTGRES_PORT below (localhost:5433) are for connecting from
# a local (non-docker) venv to the dockerized db, e.g. `docker compose up -d
# db` + `pytest` locally - the default workflow for testing each phase.
# Inside docker compose, the app container overrides both to db:5432
# automatically (see docker-compose.yml), so this file doesn't need to
# change for the full `docker compose up` path.
# 5433, not 5432, because a locally-installed Postgres (Postgres.app, brew,
# etc.) commonly already owns 5432 - unrelated to this project.
POSTGRES_USER=sdr
POSTGRES_PASSWORD=sdr
POSTGRES_DB=sdr
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Embedding model, run locally via sentence-transformers.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Default retrieval path: "dense", "lexical", or "hybrid". Explicit
# sdr.retrieval.search(strategy=...) calls (e.g. Phase 7's benchmark) override
# this per call.
RETRIEVAL_STRATEGY=hybrid
RETRIEVAL_RERANK=false
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Local LLM for answer generation, served by Ollama. OLLAMA_HOST below
# (localhost:11434) assumes a natively-installed Ollama - same pattern as
# POSTGRES_HOST/PORT above. Inside docker compose, the app container
# overrides this to http://ollama:11434 automatically. Pull the model
# first: `ollama pull gemma2:2b` (native) or
# `docker compose exec ollama ollama pull gemma2:2b` (containerized).
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma2:2b

# FastAPI service (Phase 8). API_HOST_PORT (docker-compose.yml) controls
# the host-side published port for `docker compose up`; these two control
# what the app binds to inside the container/process.
API_HOST=0.0.0.0
API_PORT=8000
UPLOAD_DIR=data/uploads

LOG_LEVEL=INFO
