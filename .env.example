# Postgres — used by the docker-compose db service and by the app to connect.
# POSTGRES_HOST/POSTGRES_PORT below (localhost:5433) are for connecting from
# a local (non-docker) venv to the dockerized db, e.g. `docker compose up -d
# db` + `pytest` locally - the default workflow for testing each phase.
# Inside docker compose, the app container overrides both to db:5432
# automatically (see docker-compose.yml), so this file doesn't need to
# change for the full `docker compose up` path.
# 5433, not 5432, because a locally-installed Postgres (Postgres.app, brew,
# etc.) commonly already owns 5432 - unrelated to this project.
POSTGRES_USER=sdr
POSTGRES_PASSWORD=sdr
POSTGRES_DB=sdr
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Embedding model, run locally via sentence-transformers.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

LOG_LEVEL=INFO
