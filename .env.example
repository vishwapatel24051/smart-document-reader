# Postgres — used by the docker-compose db service and by the app to connect.
# POSTGRES_HOST should stay "localhost" for local (non-docker) runs and is
# overridden to "db" automatically inside docker-compose.
POSTGRES_USER=sdr
POSTGRES_PASSWORD=sdr
POSTGRES_DB=sdr
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Embedding model, run locally via sentence-transformers (wired up in Phase 4).
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

LOG_LEVEL=INFO
